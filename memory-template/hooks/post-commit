#!/bin/sh
# Envoie chaque commit à la copie du serveur (remote `hub`), lue par la webapp EZBrain Hub. Facultatif.
# Installation : cp hooks/post-commit .git/hooks/ && chmod +x .git/hooks/post-commit
# Push synchrone : Codex tue les processus d'arrière-plan à la fin de chaque commande, un push détaché n'aboutissait pas.
# Serveur injoignable : abandon après 5 s, le commit suivant poussera le retard. Échecs dans .git/ezbrain-push.log.
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0
out=$(GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=5" git push -q hub main 2>&1) ||
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$(printf '%s' "$out" | tr '\n' ' ')" >> "$(git rev-parse --git-dir)/ezbrain-push.log"
exit 0
